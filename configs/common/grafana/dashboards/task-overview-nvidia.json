    {
      "id": 33,
      "title": "Logs Volume",
      "description": "每个时间窗的日志条数；无级别信息归 unknown，图例求和不代替精确全时段日志计数。",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "$loki_datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (log_level) (count_over_time({task=${task:doublequote},instance_role=~\"$instance_role\",replica=~\"$replica\",source_file=~\"$source_file\"} |= ${log_search:doublequote} | label_format log_level=`{{if .detected_level}}{{.detected_level}}{{else}}unknown{{end}}` [$__interval]))",
          "legendFormat": "{{log_level}}",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "loki",
            "uid": "$loki_datasource"
          },
          "queryType": "range"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "logs"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "debug"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
