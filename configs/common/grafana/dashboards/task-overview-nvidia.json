      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vllm:request_success_total{task=~`${task:regex}`}[$__rate_interval]))",
          "legendFormat": "请求/s",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
