// 所有 rank 日志共用；由环境清单生成 targets。
logging {
  level  = "info"
  format = "logfmt"
}

loki.source.file "inference" {
  targets = @@LOG_TARGETS@@

  // 首次读取已有内容，之后从持久化 positions 继续。
  tail_from_end = false

  // SGLang Pod 会在启动时创建 Rank 文件；周期发现允许 Alloy 先启动。
  file_match {
    enabled     = true
    sync_period = "2s"
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "@@LOKI_PUSH_URL@@"

    batch_wait = "1s"
    batch_size = "1MiB"

    min_backoff_period  = "500ms"
    max_backoff_period  = "5m"
    max_backoff_retries = 10
  }
}
