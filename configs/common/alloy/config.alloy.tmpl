// 所有 rank 日志共用；由环境清单生成 targets。
logging {
  level  = "info"
  format = "logfmt"
}

// 独立发现组件兼容 Alloy v1.8；允许服务启动后才创建日志文件。
local.file_match "inference" {
  path_targets = @@LOG_TARGETS@@
  sync_period = "2s"
}

loki.source.file "inference" {
  targets = local.file_match.inference.targets

  // 首次读取已有内容，之后从持久化 positions 继续。
  tail_from_end = false

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "@@LOKI_PUSH_URL@@"

    batch_wait = "1s"
    batch_size = "1MiB"

    min_backoff_period  = "500ms"
    max_backoff_period  = "5m"
    max_backoff_retries = 10
  }
}
