{
  "schema_version": 1,
  "project": "llm-bench-mac",
  "simulation": true,
  "runtime": [
    "docker"
  ],
  "storage": {
    "root": "generated/mac-smoke",
    "logs": "generated/mac-smoke-logs",
    "tokenizer": "configs/fixtures/mock-tokenizer"
  },
  "images": {
    "toolbox": "llm-benchmark-toolbox:local-arm64",
    "aisbench": "llm-benchmark-aisbench:e330dc1-arm64",
    "prometheus": "prom/prometheus:v3.5.0",
    "grafana": "grafana/grafana:12.0.2",
    "loki": "grafana/loki:3.5.0",
    "alloy": "grafana/alloy:v1.8.3",
    "node-exporter": "prom/node-exporter:v1.9.1",
    "nvidia_exporter": "swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/nvidia/dcgm-exporter:4.8.4",
    "hygon_exporter": "harbor.sourcefind.cn:5443/hcu/admin/base/dcu-exporter:v2.4.1"
  },
  "gpu": {
    "vendor": "nvidia",
    "deployment": "local",
    "nodes": [
      {
        "name": "single-node",
        "gpus": 1
      }
    ]
  },
  "inference": {
    "base_url": "http://fixture:18000/",
    "model": "mock-model",
    "api": "completions",
    "engine": "auto"
  },
  "topology": {
    "kind": "single",
    "tp": 1,
    "pp": 1,
    "metrics_endpoints": [
      {
        "target": "fixture:18000",
        "role": "master"
      }
    ]
  },
  "log_files": [
    "server.log"
  ],
  "ports": {
    "grafana": 33000,
    "prometheus": 39090,
    "loki": 33100,
    "alloy": 32345,
    "node-exporter": 39100,
    "gpu-exporter": 39400,
    "fixture": 38080
  },
  "startup_timeout": 180,
  "benchmark": {
    "dataset_type": "string",
    "input_length": 32,
    "output_length": 16,
    "request_count": 8,
    "concurrency": 2,
    "request_rate": 0,
    "warmups": 1,
    "mode": "perf",
    "generation_kwargs": {
      "temperature": 0,
      "ignore_eos": true
    }
  },
  "platform": "linux/arm64",
  "port_bind_address": "0.0.0.0"
}
