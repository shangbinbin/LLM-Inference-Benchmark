{
  "schema_version": 1,
  "project": "llm-bench-nvidia",
  "simulation": false,
  "host_metrics": "host",
  "runtime": [
    "docker"
  ],
  "storage": {
    "root": "/srv/llm-benchmark",
    "logs": "/srv/inference-logs",
    "tokenizer": "/srv/REPLACE_MODEL_TOKENIZER"
  },
  "images": {
    "toolbox": "llm-benchmark-toolbox:local-amd64",
    "aisbench": "llm-benchmark-aisbench:e330dc1-amd64",
    "prometheus": "swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/prom/prometheus:v3.5.0",
    "grafana": "swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/grafana/grafana:12.0.2",
    "loki": "swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/grafana/loki:3.5.0",
    "alloy": "swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/grafana/alloy:v1.8.3",
    "node-exporter": "swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/prom/node-exporter:v1.9.1",
    "nvidia_exporter": "swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/nvidia/dcgm-exporter:4.8.4",
    "hygon_exporter": "harbor.sourcefind.cn:5443/hcu/admin/base/hcu-exporter:v3.0.0"
  },
  "gpu": {
    "vendor": "auto",
    "deployment": "local",
    "nodes": [
      {
        "name": "single-node",
        "gpus": 1
      }
    ]
  },
  "inference": {
    "base_url": "http://REPLACE_INFERENCE_HOST:30000/",
    "model": "REPLACE_MODEL",
    "api": "completions"
  },
  "topology": {
    "kind": "single",
    "tp": 1,
    "pp": 1,
    "metrics_endpoints": [
      {
        "target": "REPLACE_INFERENCE_HOST:30000",
        "role": "master"
      }
    ]
  },
  "log_files": [
    "server.log"
  ],
  "ports": {
    "grafana": 33000,
    "prometheus": 39090,
    "loki": 33100,
    "alloy": 32345,
    "node-exporter": 39100,
    "gpu-exporter": 39400,
    "fixture": 38080
  },
  "startup_timeout": 120,
  "benchmark": {
    "dataset_type": "string",
    "input_length": 1024,
    "output_length": 256,
    "request_count": 1000,
    "concurrency": 16,
    "request_rate": 0,
    "warmups": 1,
    "mode": "perf",
    "generation_kwargs": {
      "temperature": 0,
      "ignore_eos": true
    }
  },
  "platform": "linux/amd64",
  "node_exporter_target": "REPLACE_HOST_ADDRESS:39100",
  "port_bind_address": "0.0.0.0"
}
