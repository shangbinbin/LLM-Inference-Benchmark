{
  "uid": "hygon-dcu-v241-overview",
  "title": "海光 DCU Exporter v2.4.1",
  "description": "本项目根据官方 2026-10-27 文档制作，非官方 Dashboard 原件；尚未实机验证。",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "hygon",
    "dcu-v2.4.1"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "benchmark-prometheus"
        },
        "query": "label_values(up{job=\"hygon-dcu-exporter\"}, node)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "minor_number",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "benchmark-prometheus"
        },
        "query": "label_values(dcu_memorycap_bytes{job=\"hygon-dcu-exporter\",node=~\"$node\"}, minor_number)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Exporter UP",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"hygon-dcu-exporter\",node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "DCU v2.4.1 contract follows archived official DCU dashboard; verify actual metric availability."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DCU 利用率",
      "description": "DCU v2.4.1 contract follows archived official DCU dashboard; verify actual metric availability.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dcu_utilizationrate{job=\"hygon-dcu-exporter\",node=~\"$node\",minor_number=~\"$minor_number\"}",
          "legendFormat": "{{node}} / {{minor_number}} / {{minor_number}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "已用显存",
      "description": "DCU v2.4.1 contract follows archived official DCU dashboard; verify actual metric availability.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dcu_usedmemory_bytes{job=\"hygon-dcu-exporter\",node=~\"$node\",minor_number=~\"$minor_number\"}",
          "legendFormat": "{{node}} / {{minor_number}} / {{minor_number}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "显存总量",
      "description": "DCU v2.4.1 contract follows archived official DCU dashboard; verify actual metric availability.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dcu_memorycap_bytes{job=\"hygon-dcu-exporter\",node=~\"$node\",minor_number=~\"$minor_number\"}",
          "legendFormat": "{{node}} / {{minor_number}} / {{minor_number}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "显存使用率",
      "description": "DCU v2.4.1 contract follows archived official DCU dashboard; verify actual metric availability.",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * dcu_usedmemory_bytes{job=\"hygon-dcu-exporter\",node=~\"$node\",minor_number=~\"$minor_number\"} / dcu_memorycap_bytes{job=\"hygon-dcu-exporter\",node=~\"$node\",minor_number=~\"$minor_number\"}",
          "legendFormat": "{{node}} / {{minor_number}} / {{minor_number}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DCU 温度",
      "description": "DCU v2.4.1 contract follows archived official DCU dashboard; verify actual metric availability.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dcu_temp{job=\"hygon-dcu-exporter\",node=~\"$node\",minor_number=~\"$minor_number\"}",
          "legendFormat": "{{node}} / {{minor_number}} / {{minor_number}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DCU 当前功耗",
      "description": "DCU v2.4.1 contract follows archived official DCU dashboard; verify actual metric availability.",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dcu_power_usage{job=\"hygon-dcu-exporter\",node=~\"$node\",minor_number=~\"$minor_number\"}",
          "legendFormat": "{{node}} / {{minor_number}} / {{minor_number}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        }
      }
    }
  ]
}
